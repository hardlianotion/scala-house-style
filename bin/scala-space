#!/bin/zsh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Etuka Onono
# scala-space [--check] [paths...]
# Applies the house spacing rule (a space before every argument, parameter and type-parameter list) to the Scala
# files under the given paths (default: the current directory). With --check, changes nothing and exits non-zero if
# any file would change. Needs no build: the rule is syntactic and runs in the standalone Scalafix CLI.
#
# Scalafix 0.14.9 fails on JDK 27 (its class-loader reflection), so it runs on JDK 21, which coursier provides.
H=${0:a:h}
check=()
[[ $1 == --check ]] && { check=(--check); shift }
(( $# )) || set -- .
files=(${(f)"$(find "$@" -name '*.scala' -not -path '*/target/*' -not -path '*/.metals/*' -not -path '*/.bloop/*' \
  -not -path '*/.scala-build/*' -not -path '*/project/project/*' -not -path '*/.git/*')"})
(( ${#files} )) || exit 0
setopt pipefail
cs launch --jvm 21 scalafix:0.14.9 -- $check --syntactic --scala-version 3.10.0 \
  --rules "file:$H/SpaceBeforeLists.scala" ${files[@]} 2>&1 | sed '/^WARNING: /d'
